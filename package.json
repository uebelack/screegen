{
  "name": "screegen",
  "version": "0.0.11",
  "license": "MIT",
  "author": "David Übelacker",
  "repository": {
    "type": "git",
    "url": "https://github.com/uebelack/screegen"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "check": "vp check",
    "test-init": "pnpm --filter @screegen/cli exec node bin/screegen.js init -n my-screenshot-app -d ../../../",
    "update-version": "node scripts/update-version.js",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "format:check": "vp fmt --check",
    "format:write": "vp fmt"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
